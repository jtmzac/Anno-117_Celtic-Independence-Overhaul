    <!-- Change intial celtic unlock to remove the lock on upgrading to the other type of residence to prevent a bricked game state -->
    <ModOp Add="@8066/Trigger/TriggerActions/Item/TriggerAction/Values/ActionUnlockAsset/UnlockAssets">
            <Item><Asset>41213</Asset></Item>
            <Item><Asset>38024</Asset></Item>
            <Item><Asset>38025</Asset></Item>
    </ModOp>

    <!-- Add neptune 4k devotion belief buff to alder councils to compensate for no cisterns on celtic islands -->
    <ModOp Add="@137876/Effect/Targets">
        <Item><GUID>6726</GUID></Item>
    </ModOp>

    <!-- Remove herb fertility requirement for herb farm and disable the fertility on starting a new game. -->
    <!-- This is needed because sausages are now used in latium instead of cheese -->
    <!-- As a side effect, this causes the barley fertility to be on every island -->
    <ModOp Remove="@31764/Factory7/NeededFertility"></ModOp>
    <ModOp Remove="@31359/FertilityPool/FertilityList/Item[Fertility = '2214']"></ModOp>

    <!-- <GUID>82500</GUID> -->
    <!-- Swap celtic shrines to using 10 tiles instead of 5 concrete. Tiles can be made by waders rather than needing nobles for concrete -->
    <ModOp GUID="82486,82487,82488,82490,82491,82492,82489" Merge="Cost/Costs/Item[Ingredient = '2176']">
        <Amount>10</Amount>
    </ModOp>
    <ModOp GUID="82486,82487,82488,82490,82491,82492,82489" Remove="Cost/Costs/Item[Ingredient = '2178']/Amount"></ModOp>

    <!-- Change Albion silo to manual variation control and add two unused celtic variants with muddy ground textures -->
    <ModOp Merge="@77955/Building">
        <VariationControl>ByPlayer</VariationControl>
    </ModOp>
    <ModOp Add="@77955/Object/Variations">
        <Item>
            <Filename>data/jtmzac/graphics/production/celtic_silo/production_module_silo_01.cfg</Filename>
        </Item>
        <Item>
            <Filename>data/jtmzac/graphics/production/celtic_silo/production_module_silo_02.cfg</Filename>
        </Item>
    </ModOp>


    <!-- Remove changed buildings from optional aqueduct consumers asset pool -->
    <!-- <GUID>71200</GUID> -->
    <ModOp Remove="@71200/AssetPool/AssetList/Item[Asset = '2799']"></ModOp>
    <ModOp Remove="@71200/AssetPool/AssetList/Item[Asset = '2800']"></ModOp>
