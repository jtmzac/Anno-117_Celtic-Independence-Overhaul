    <!-- Compatibility patch for my rocky patron of construction mod -->
    <Group Condition="#rocky-patron-of-construction-jtmzac">
        <!-- Add tiles amount to albion version of shrine if tiles is already in list as an ingredient -->
        <ModOp Merge="@1400300412/Cost/Costs/Item[Ingredient = '2176']" Condition="@1400300412/Cost/Costs/Item[Ingredient = '2176']">
            <Amount>10</Amount>
        </ModOp>
        <!-- Else add new tiles ingredient with amount -->
        <ModOp Add="@1400300412/Cost/Costs" Condition="!@1400300412/Cost/Costs/Item[Ingredient = '2176']">
            <Item>
                <Ingredient>2176</Ingredient>
                <Amount>10</Amount>
            </Item>
        </ModOp>
        <!-- Remove concrete cost from shrine -->
        <ModOp Remove="@1400300412/Cost/Costs/Item[Ingredient = '2178']/Amount"></ModOp>

        <!-- Remove aqueduct from granite quarry -->
        <ModOp Remove="@5295/AqueductConsumer" Condition="@5295/AqueductConsumer"></ModOp>
    </Group>







