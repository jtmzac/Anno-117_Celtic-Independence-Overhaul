    <!-- Additional retroactive unlock for celtic hemp farm -->
    <Asset>
        <Template>TriggerIntermediateLevel</Template>
        <Values>
            <Standard>
                <GUID>1400300644</GUID>
                <Name>Trigger Intermediate Level Celtic 1.2 celtic hemp</Name>
            </Standard>
            <Trigger>
                <TriggerCondition>
                    <Template>ConditionPlayerCounter</Template>
                    <Values>
                        <Condition />
                        <ConditionPlayerCounter>
                            <PlayerCounter>PopulationByLevel</PlayerCounter>
                            <Context>1500</Context>
                            <CounterAmount>50</CounterAmount>
                        </ConditionPlayerCounter>
                        <ConditionLocationProps />
                        <ConditionCounterProps />
                        <ConditionPropsComparable />
                    </Values>
                </TriggerCondition>
                <TriggerActions>
                    <Item>
                        <TriggerAction>
                            <Template>ActionUnlockAsset</Template>
                            <Values>
                                <Action />
                                <ActionUnlockAsset>
                                    <UnlockAssets>
                                        <Item>
                                            <Asset>1400300643</Asset>
                                        </Item>
                                    </UnlockAssets>
                                </ActionUnlockAsset>
                            </Values>
                        </TriggerAction>
                    </Item>
                </TriggerActions>
            </Trigger>
            <TriggerSetup>
                <AutoRegisterTrigger>1</AutoRegisterTrigger>
                <UsedByFirstParties>1</UsedByFirstParties>
            </TriggerSetup>
            <TrackingData />
        </Values>
    </Asset>


