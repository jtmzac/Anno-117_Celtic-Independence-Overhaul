    <!-- Asset pool used for targeting the new fertiliser silo buff -->
    <Asset>
        <Template>AssetPoolNamed</Template>
        <Values>
            <Standard>
                <GUID>1400300640</GUID>
                <Name>Celtic Farms</Name>
            </Standard>
            <AssetPool>
                <AssetList>
                    <Item><Asset>2799</Asset></Item>
                    <Item><Asset>2800</Asset></Item>
                    <Item><Asset>1400300643</Asset></Item>
                    <Item><Asset>1400300650</Asset></Item>
                    <Item><Asset>1400300700</Asset></Item>
                </AssetList>
            </AssetPool>
            <Text>
                <OasisId>-6903204273226852953</OasisId>
            </Text>
        </Values>
    </Asset>



    <!-- Remove aqueduct support from celtic farms/plantations -->
    <ModOp GUID="2799,2800" Remove="AqueductConsumer"></ModOp>

    <!-- Add new fertiliser silo to celtic farms/plantations -->
    <ModOp GUID="2799,2800" Merge="ModuleOwner">
        <AdditionalModule>1400300624</AdditionalModule>
        <ModuleBuildRadius>8</ModuleBuildRadius>
    </ModOp>

    <!-- Add celtic symbol to celtic farm/plantation icons to indicate they support fertiliser silos -->
    <ModOp Merge="@2799/Standard">
        <IconFilename>data/jtmzac/icons/icon_3d_celtic_barley_goods.png</IconFilename>
    </ModOp>
    <ModOp Merge="@2800/Standard">
        <IconFilename>data/jtmzac/icons/icon_3d_celtic_dye_plants_goods.png</IconFilename>
    </ModOp>


    <!-- The ceres extra fields buff targets the "all farm" and "all plantations" asset pools by default. Because these pools are also used by other buffs, they need to be swapped out for new, different asset pools -->
    <Asset>
        <Template>AssetPoolNamed</Template>
        <Values>
            <Standard>
                <GUID>1400300641</GUID>
                <Name>Asset Pool Production All Farms EXCEPT Celtic</Name>
            </Standard>
            <AssetPool>
                <AssetList />
            </AssetPool>
            <Text>
                <OasisId>-6908999943213506085</OasisId>
            </Text>
        </Values>
    </Asset>
    <Asset>
        <Template>AssetPoolNamed</Template>
        <Values>
            <Standard>
                <GUID>1400300642</GUID>
                <Name>Asset Pool Production All Plantations EXCEPT Celtic</Name>
            </Standard>
            <AssetPool>
                <AssetList />
            </AssetPool>
            <Text>
                <OasisId>-6911450256402636112</OasisId>
            </Text>
        </Values>
    </Asset>

    <!-- Instead of hardcoding the above asset pools, the following modops copy the all farms/plantations pools from the game and then removes the undesired celtic farms/plantations. This should be more resilient to future game updates. -->
    <!-- NOTE: The following couple of modops will throw path not found errors if you're using the vscode plugin, but do work properly based on my testing.  -->
    <ModOp  Replace="@1400300641/AssetPool/AssetList" Content="@42602/AssetPool/AssetList" ></ModOp>
    <ModOp  Remove="@1400300641/AssetPool/AssetList/Item[Asset = '2799']"></ModOp>
    <ModOp  Replace="@1400300642/AssetPool/AssetList" Content="@51905/AssetPool/AssetList" ></ModOp>
    <ModOp  Remove="@1400300642/AssetPool/AssetList/Item[Asset = '2800']"></ModOp>

    <!-- Change ceres extra fields buff targets to new asset pools -->
    <ModOp Replace="@43620/Effect/Targets">
        <Targets>
            <Item><GUID>1400300641</GUID></Item>
            <Item><GUID>1400300642</GUID></Item>
        </Targets>
    </ModOp>





