    <!-- unhide from either type of wader residence -->
    <Asset>
        <Template>TriggerIntermediateLevel</Template>
        <Values>
            <Standard>
                <GUID>1400300683</GUID>
                <Name>Trigger Intermediate Level Celtic 1.0 roman celtic market</Name>
            </Standard>
            <Trigger>
                <TriggerCondition>
                    <Template>ConditionAlwaysTrue</Template>
                    <Values>
                        <Condition>
                            <SubConditionCompletionOrder>MutuallyExclusive</SubConditionCompletionOrder>
                        </Condition>
                        <ConditionAlwaysTrue />
                    </Values>
                </TriggerCondition>
                <TriggerActions>
                    <Item>
                        <TriggerAction>
                            <Template>ActionUnlockAsset</Template>
                            <Values>
                                <Action />
                                <ActionUnlockAsset>
                                    <UnhideAssets>
                                        <Item>
                                            <Asset>1400300681</Asset>
                                        </Item>
                                    </UnhideAssets>
                                </ActionUnlockAsset>
                            </Values>
                        </TriggerAction>
                    </Item>
                </TriggerActions>
                <SubTriggers>
                    <Item>
                        <SubTrigger>
                            <Template>AutoCreateTrigger</Template>
                            <Values>
                                <Trigger>
                                    <TriggerCondition>
                                        <Template>ConditionPlayerCounter</Template>
                                        <Values>
                                            <Condition />
                                            <ConditionPlayerCounter>
                                                <Context>6414</Context>
                                                <CounterAmount>1</CounterAmount>
                                            </ConditionPlayerCounter>
                                            <ConditionLocationProps />
                                            <ConditionCounterProps />
                                            <ConditionPropsComparable />
                                        </Values>
                                    </TriggerCondition>
                                </Trigger>
                            </Values>
                        </SubTrigger>
                    </Item>
                    <Item>
                        <SubTrigger>
                            <Template>AutoCreateTrigger</Template>
                            <Values>
                                <Trigger>
                                    <TriggerCondition>
                                        <Template>ConditionPlayerCounter</Template>
                                        <Values>
                                            <Condition />
                                            <ConditionPlayerCounter>
                                                <Context>1400300520</Context>
                                                <CounterAmount>1</CounterAmount>
                                            </ConditionPlayerCounter>
                                            <ConditionLocationProps />
                                            <ConditionCounterProps />
                                            <ConditionPropsComparable />
                                        </Values>
                                    </TriggerCondition>
                                </Trigger>
                            </Values>
                        </SubTrigger>
                    </Item>
                </SubTriggers>
            </Trigger>
            <TriggerSetup>
                <AutoRegisterTrigger>1</AutoRegisterTrigger>
                <UsedByFirstParties>1</UsedByFirstParties>
            </TriggerSetup>
            <TrackingData />
        </Values>
    </Asset>
