    <!-- Unlock fertiliser, fertiliser pit, fertiliser silo, and apply fertiliser from aurochs buff above 4k epona devotion -->
    <Asset>
        <Template>Trigger</Template>
        <Values>
        <Standard>
            <GUID>1400300627</GUID>
            <Name>Fertiliser Unlock</Name>
        </Standard>
        <Trigger>
            <TriggerCondition>
                <Template>ConditionPlayerCounter</Template>
                <Values>
                    <Condition />
                    <ConditionPlayerCounter>
                        <PlayerCounter>PatronDevotion</PlayerCounter>
                        <Context>80861</Context>
                        <ComparisonOp>MoreThan</ComparisonOp>
                        <CounterAmount>3999</CounterAmount>
                    </ConditionPlayerCounter>
                    <ConditionLocationProps />
                    <ConditionCounterProps />
                </Values>
            </TriggerCondition>
            <TriggerActions>
                <Item>
                    <TriggerAction>
                        <Template>ActionUnlockAsset</Template>
                        <Values>
                            <Action />
                            <ActionUnlockAsset>
                                <UnlockAssets>
                                    <Item>
                                        <Asset>1400300620</Asset>
                                    </Item>
                                    <Item>
                                        <Asset>1400300621</Asset>
                                    </Item>
                                    <Item>
                                        <Asset>1400300624</Asset>
                                    </Item>
                                </UnlockAssets>
                            </ActionUnlockAsset>
                        </Values>
                    </TriggerAction>
                </Item>
                <Item>
                    <TriggerAction>
                        <Template>ActionEffect</Template>
                            <Values>
                            <Action />
                            <ActionEffect>
                                <EffectAsset>1400300622</EffectAsset>
                                <StartEffect>1</StartEffect>
                            </ActionEffect>
                        </Values>
                    </TriggerAction>
                </Item>
                <Item>
                    <TriggerAction>
                        <Template>ActionRegisterTrigger</Template>
                        <Values>
                            <Action />
                            <ActionRegisterTrigger>
                                <TriggerAsset>1400300628</TriggerAsset>
                            </ActionRegisterTrigger>
                        </Values>
                    </TriggerAction>
                </Item>
            </TriggerActions>
        </Trigger>
        <TriggerSetup>
            <AutoRegisterTrigger>1</AutoRegisterTrigger>
            <UsedByFirstParties>1</UsedByFirstParties>
        </TriggerSetup>
        </Values>
    </Asset>

